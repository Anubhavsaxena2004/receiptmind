# Copy to .env.local and fill in what you have. Everything is optional —
# without keys the app still runs fully, using a clearly labelled payment simulator.

# Public URL of the app. Used for PayPal return URLs and links in Zapier messages.
APP_URL=http://localhost:3000

# PayPal Sandbox — developer.paypal.com → Apps & Credentials → Sandbox app.
# Without these, checkout uses the simulated provider.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same Sandbox app (subscribe to PAYMENT.CAPTURE.* events,
# URL: <APP_URL>/api/webhooks/paypal). Needed for verified webhooks.
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Receipt scanning with Claude (console.anthropic.com). Manual entry works without it.
ANTHROPIC_API_KEY=

# Zapier "Catch Hook" URL. Every notification is POSTed here as JSON
# { app, event, title, message, link, at } so a Zap can email / WhatsApp / log it.
ZAPIER_WEBHOOK_URL=

# Protects POST /api/scheduler/run so a cron job can trigger the daily bill check.
CRON_SECRET=

# --- Where data is saved ---------------------------------------------------
# Serverless hosts (Vercel) can't write files. Add Upstash Redis and data is kept there:
#   Vercel → your project → Storage → Upstash for Redis → Connect.
# Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN automatically; these also work:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Without Redis: data is saved to ./data (or TINKU_DATA_DIR, e.g. a Render disk).
# On Vercel without Redis it falls back to temporary /tmp storage and shows a warning.
# TINKU_DATA_DIR=
